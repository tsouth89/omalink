#!/usr/bin/env bash

set -euo pipefail

usage() {
  echo "Usage: omalink <status|watch|ring|clipboard|share|dismiss|dismiss-all|notify-reply|contacts|conversations|messages|attachment|attachment-save|reply|sms> [arguments]" >&2
  exit 2
}

status() {
  if ! command -v kdeconnect-cli >/dev/null 2>&1; then
    jq -cn '{ok: true, installed: false, devices: [], statusText: "KDE Connect is not installed"}'
    return
  fi

  local raw line id name device_path charge charging network_strength network_type notifications
  local -a devices=()
  raw="$(kdeconnect-cli --list-available --id-name-only 2>/dev/null || true)"

  while IFS= read -r line; do
    [[ -n $line ]] || continue
    id="${line%% *}"
    name="${line#* }"
    [[ -n $id && $name != "$line" ]] || continue
    device_path="/modules/kdeconnect/devices/$id"
    charge="$(dbus_property "$device_path/battery" org.kde.kdeconnect.device.battery charge i)"
    charging="$(dbus_property "$device_path/battery" org.kde.kdeconnect.device.battery isCharging b)"
    network_strength="$(dbus_property "$device_path/connectivity_report" org.kde.kdeconnect.device.connectivity_report cellularNetworkStrength i)"
    network_type="$(dbus_property "$device_path/connectivity_report" org.kde.kdeconnect.device.connectivity_report cellularNetworkType s)"
    notifications="$(notification_json "$device_path")"
    devices+=("$(jq -cn \
      --arg id "$id" \
      --arg name "$name" \
      --argjson charge "${charge:-null}" \
      --argjson charging "${charging:-false}" \
      --argjson networkStrength "${network_strength:-null}" \
      --arg networkType "${network_type:-}" \
      --argjson notifications "${notifications:-[]}" \
      '{id: $id, name: $name, battery: {charge: $charge, charging: $charging}, connectivity: {strength: $networkStrength, type: $networkType}, notifications: $notifications}')")
  done <<<"$raw"

  if (( ${#devices[@]} == 0 )); then
    jq -cn '{ok: true, installed: true, devices: [], statusText: "No phone connected"}'
  else
    printf '%s\n' "${devices[@]}" | jq -sc '
      {ok: true, installed: true, devices: ., statusText:
        (if length == 1 then .[0].name else "\(length) phones connected" end)}'
  fi
}

notification_json() {
  local device_path="$1" notification_root="$1/notifications" raw notification_id notification_path
  local app_name title text icon_path dismissable reply_id is_conversation
  local -a notifications=()

  raw="$(busctl --user --json=short call org.kde.kdeconnect "$notification_root" \
    org.kde.kdeconnect.device.notifications activeNotifications 2>/dev/null || true)"
  while IFS= read -r notification_id; do
    [[ $notification_id =~ ^[A-Za-z0-9._:-]+$ ]] || continue
    notification_path="$notification_root/$notification_id"
    app_name="$(dbus_json_property "$notification_path" appName)"
    title="$(dbus_json_property "$notification_path" title)"
    text="$(dbus_json_property "$notification_path" text)"
    icon_path="$(dbus_json_property "$notification_path" iconPath)"
    dismissable="$(dbus_json_property "$notification_path" dismissable)"
    reply_id="$(dbus_json_property "$notification_path" replyId)"
    is_conversation="$(dbus_json_property "$notification_path" isConversation)"
    notifications+=("$(jq -cn \
      --arg id "$notification_id" \
      --arg appName "$app_name" \
      --arg title "$title" \
      --arg text "$text" \
      --arg iconPath "$icon_path" \
      --argjson dismissable "${dismissable:-false}" \
      --arg replyId "$reply_id" \
      --argjson isConversation "${is_conversation:-false}" \
      '{id: $id, appName: $appName, title: $title, text: $text, iconPath: $iconPath, dismissable: $dismissable, replyId: $replyId, replyable: ($replyId != ""), isConversation: $isConversation}')")
  done < <(jq -r '.data[0][]?' <<<"$raw" 2>/dev/null)

  if (( ${#notifications[@]} == 0 )); then
    printf '%s\n' '[]'
  else
    printf '%s\n' "${notifications[@]}" | jq -sc '.'
  fi
}

dbus_json_property() {
  local path="$1" property="$2"
  busctl --user --json=short get-property org.kde.kdeconnect "$path" \
    org.kde.kdeconnect.device.notifications.notification "$property" 2>/dev/null \
    | jq -r '.data // empty' 2>/dev/null || true
}

dbus_property() {
  local path="$1" interface="$2" property="$3" signature="$4" raw
  raw="$(busctl --user get-property org.kde.kdeconnect "$path" "$interface" "$property" 2>/dev/null || true)"
  [[ $raw == "$signature "* ]] || return 0
  raw="${raw#* }"
  if [[ $signature == s ]]; then
    jq -r '.' <<<"$raw" 2>/dev/null || true
  else
    printf '%s\n' "$raw"
  fi
}

ring() {
  local device_id="${1:-}"
  [[ -n $device_id ]] || usage
  command -v kdeconnect-cli >/dev/null 2>&1 || {
    echo "KDE Connect is not installed" >&2
    exit 1
  }
  kdeconnect-cli --device "$device_id" --ring
}

send_clipboard() {
  local device_id="${1:-}"
  [[ -n $device_id ]] || usage
  command -v kdeconnect-cli >/dev/null 2>&1 || {
    echo "KDE Connect is not installed" >&2
    exit 1
  }
  kdeconnect-cli --device "$device_id" --send-clipboard
}

share_text() {
  local device_id="${1:-}" value="${2:-}"
  [[ $device_id =~ ^[A-Za-z0-9]+$ && -n $value ]] || usage
  command -v kdeconnect-cli >/dev/null 2>&1 || {
    echo "KDE Connect is not installed" >&2
    exit 1
  }
  if [[ $value =~ ^https?:// ]]; then
    kdeconnect-cli --device "$device_id" --share "$value"
  else
    kdeconnect-cli --device "$device_id" --share-text "$value"
  fi
}

dismiss_notification() {
  local device_id="${1:-}" notification_id="${2:-}"
  [[ $device_id =~ ^[A-Za-z0-9]+$ && $notification_id =~ ^[A-Za-z0-9._:-]+$ ]] || usage
  busctl --user call org.kde.kdeconnect \
    "/modules/kdeconnect/devices/$device_id/notifications/$notification_id" \
    org.kde.kdeconnect.device.notifications.notification dismiss >/dev/null
}

# KDE Connect's own desktop popups for phone notifications carry no default
# action, so clicking them in the Omarchy notification popup does nothing.
# OmaLink silences that one event and emits its own popups instead, with a
# click action that opens the OmaLink panel. Message contents are never shown
# in popups; they are readable in the panel and Messages window.
ensure_quiet_daemon_popups() {
  local config="${XDG_CONFIG_HOME:-$HOME/.config}/kdeconnect.notifyrc"
  mkdir -p "$(dirname "$config")"
  if [[ -e $config ]]; then
    grep -q '^\[Event/notification\]' "$config" \
      || printf '\n[Event/notification]\nAction=\n' >>"$config"
    return 0
  fi
  printf '# Written by OmaLink: it shows its own phone notification popups.\n[Event/notification]\nAction=\n' >"$config"
}

notify_escape() {
  local value="$1"
  value="${value//&/&amp;}"
  value="${value//</&lt;}"
  value="${value//>/&gt;}"
  printf '%s' "$value"
}

handle_posted() {
  local device_id="$1" notification_id="$2" notification_path app_name title text is_conversation icon_path summary body action
  [[ $device_id =~ ^[A-Za-z0-9]+$ && $notification_id =~ ^[A-Za-z0-9._:-]+$ ]] || return 0
  sleep 0.3
  notification_path="/modules/kdeconnect/devices/$device_id/notifications/$notification_id"
  app_name="$(dbus_json_property "$notification_path" appName)"
  title="$(dbus_json_property "$notification_path" title)"
  text="$(dbus_json_property "$notification_path" text)"
  is_conversation="$(dbus_json_property "$notification_path" isConversation)"
  icon_path="$(dbus_json_property "$notification_path" iconPath)"
  [[ ${app_name,,} == spotify && $is_conversation != true ]] && return 0
  if [[ $is_conversation == true ]]; then
    summary="New message"
    body="Open OmaLink to read it"
  else
    summary="${title:-${app_name:-Phone notification}}"
    body="$(notify_escape "$text")"
  fi
  action="$(timeout 300 notify-send -a OmaLink ${icon_path:+-i "$icon_path"} \
    -A "default=Open" -- "$summary" "$body" 2>/dev/null || true)"
  if [[ $action == default ]]; then
    qs -p "${OMARCHY_PATH:-/usr/share/omarchy}/shell" ipc call omalink.phone open >/dev/null 2>&1 || true
  fi
}

watch() {
  command -v dbus-monitor >/dev/null 2>&1 || { echo "dbus-monitor is required" >&2; exit 1; }
  # One watcher only, even with a Service instance per bar: the first holds
  # the lock, the rest block here as standbys and take over if it dies. Child
  # processes must not inherit the lock fd (9>&-) or a stray would keep it.
  exec 9>"${XDG_RUNTIME_DIR:-/tmp}/omalink-watch.lock"
  flock 9
  ensure_quiet_daemon_popups || true
  local line device_id="" notification_id
  while IFS= read -r line; do
    case $line in
      *"member=notificationPosted"*)
        device_id="${line#*path=/modules/kdeconnect/devices/}"
        device_id="${device_id%%/*}"
        ;;
      *'string "'*)
        [[ -n $device_id ]] || continue
        notification_id="${line#*string \"}"
        notification_id="${notification_id%\"*}"
        handle_posted "$device_id" "$notification_id" 9>&- &
        printf 'posted %s %s\n' "$device_id" "$notification_id"
        device_id=""
        ;;
    esac
  done < <(dbus-monitor --session \
    "type='signal',interface='org.kde.kdeconnect.device.notifications',member='notificationPosted'" 2>/dev/null 9>&-)
  wait
}

notify_reply() {
  local device_id="${1:-}" reply_id="${2:-}" message="${3:-}"
  [[ $device_id =~ ^[A-Za-z0-9]+$ && $reply_id =~ ^[A-Za-z0-9._:-]+$ && -n $message ]] || usage
  busctl --user call org.kde.kdeconnect \
    "/modules/kdeconnect/devices/$device_id/notifications" \
    org.kde.kdeconnect.device.notifications sendReply ss "$reply_id" "$message" >/dev/null
}

dismiss_all_notifications() {
  local device_id="${1:-}" notification_root raw notification_id
  [[ $device_id =~ ^[A-Za-z0-9]+$ ]] || usage
  notification_root="/modules/kdeconnect/devices/$device_id/notifications"
  raw="$(busctl --user --json=short call org.kde.kdeconnect "$notification_root" \
    org.kde.kdeconnect.device.notifications activeNotifications 2>/dev/null || true)"
  while IFS= read -r notification_id; do
    [[ $notification_id =~ ^[A-Za-z0-9._:-]+$ ]] || continue
    busctl --user call org.kde.kdeconnect "$notification_root/$notification_id" \
      org.kde.kdeconnect.device.notifications.notification dismiss >/dev/null 2>&1 || true
  done < <(jq -r '.data[0][]?' <<<"$raw" 2>/dev/null)
}

contact_records_json() {
  local device_id="$1" device_path contact_dir
  device_path="/modules/kdeconnect/devices/$device_id"
  contact_dir="${XDG_DATA_HOME:-$HOME/.local/share}/kpeoplevcard/kdeconnect-$device_id"

  busctl --user call org.kde.kdeconnect "$device_path/contacts" \
    org.kde.kdeconnect.device.contacts synchronizeRemoteWithLocal >/dev/null 2>&1 || true

  if ! compgen -G "$contact_dir/*.vcf" >/dev/null; then
    printf '%s\n' '[]'
    return
  fi

  awk '
    function value() { return substr($0, index($0, ":") + 1) }
    /^BEGIN:VCARD/ { name = ""; phone_count = 0 }
    /^FN[;:]/ { name = value(); gsub(/\\,/, ",", name); gsub(/\\;/, ";", name) }
    /^TEL[;:]/ { phones[++phone_count] = value() }
    /^END:VCARD/ {
      gsub(/[\t\r\n]/, " ", name)
      for (i = 1; i <= phone_count; i++) if (name != "") print phones[i] "\t" name
      delete phones
    }
  ' "$contact_dir"/*.vcf | jq -Rsc '
    split("\n")
    | map(select(length > 0) | split("\t") | {number: .[0], name: .[1]})
    | unique_by(.number)
    | sort_by(.name | ascii_downcase)
  '
}

contacts() {
  local device_id="${1:-}"
  [[ $device_id =~ ^[A-Za-z0-9]+$ ]] || usage
  contact_records_json "$device_id"
}

conversations() {
  local device_id="${1:-}" device_path contacts raw
  [[ $device_id =~ ^[A-Za-z0-9]+$ ]] || usage
  device_path="/modules/kdeconnect/devices/$device_id"
  contacts="$(contact_records_json "$device_id")"

  raw="$(busctl --user --json=short call org.kde.kdeconnect "$device_path" \
    org.kde.kdeconnect.device.conversations activeConversations)"
  jq -c --argjson contacts "$contacts" '
    def number_key:
      gsub("[^0-9]"; "") | if length > 10 then .[-10:] else . end;
    ($contacts | reduce .[] as $contact ({};
      .[($contact.number | number_key)] = $contact.name)) as $contactNames
    |
    def display_name:
      . as $address | ($address | number_key) as $key | $contactNames[$key] // $address;
    [.data[0][]? | .data as $message | {
      threadId: $message[6],
      preview: $message[1],
      addresses: ([$message[2][]?[0]] | unique),
      names: ([$message[2][]?[0] | display_name] | unique),
      timestamp: $message[3],
      unread: ($message[5] == 0),
      incoming: ($message[4] == 1),
      attachmentCount: ($message[9] | length),
      attachments: [$message[9][]? | {partId: .[0], mimeType: .[1], thumbnail: .[2], unique: .[3]}]
    }]
    | sort_by(.timestamp)
    | reverse
  ' <<<"$raw"
}

messages() {
  local device_id="${1:-}" thread_id="${2:-}" device_path capture_dir capture_file monitor_pid
  [[ $device_id =~ ^[A-Za-z0-9]+$ && $thread_id =~ ^[0-9]+$ ]] || usage
  device_path="/modules/kdeconnect/devices/$device_id"
  capture_dir="$(mktemp -d)"
  capture_file="$capture_dir/signals"
  monitor_pid=""

  cleanup_messages() {
    [[ -z $monitor_pid ]] || kill "$monitor_pid" 2>/dev/null || true
    rm -r "$capture_dir"
  }
  trap cleanup_messages RETURN

  stdbuf -oL busctl --user --verbose --json=short monitor org.kde.kdeconnect >"$capture_file" &
  monitor_pid=$!
  sleep 0.1
  timeout 12s busctl --user call org.kde.kdeconnect "$device_path" \
    org.kde.kdeconnect.device.conversations requestConversation xii "$thread_id" 0 30 >/dev/null \
    || true

  sleep 0.5
  kill "$monitor_pid" 2>/dev/null || true
  wait "$monitor_pid" 2>/dev/null || true
  monitor_pid=""

  jq -sc --argjson threadId "$thread_id" '
    [.[]
      | select(.type == "signal"
          and .interface == "org.kde.kdeconnect.device.conversations"
          and .member == "conversationUpdated")
      | .payload.data[0].data
      | select(.[6] == $threadId)
      | {
          body: .[1],
          timestamp: .[3],
          incoming: (.[4] == 1),
          attachmentCount: (.[9] | length),
          attachments: [.[9][]? | {partId: .[0], mimeType: .[1], thumbnail: .[2], unique: .[3]}]
        }]
    | unique_by(.timestamp, .body, ([.attachments[].unique] | join("|")))
    | sort_by(.timestamp)
  ' "$capture_file"
}

attachment() {
  local device_id="${1:-}" part_id="${2:-}" unique="${3:-}" device_path capture_dir capture_file monitor_pid path attempt
  [[ $device_id =~ ^[A-Za-z0-9]+$ && $part_id =~ ^-?[0-9]+$ && $unique =~ ^[[:print:]]+$ ]] || usage
  device_path="/modules/kdeconnect/devices/$device_id"
  capture_dir="$(mktemp -d)"
  capture_file="$capture_dir/signals"
  monitor_pid=""

  cleanup_attachment() {
    [[ -z $monitor_pid ]] || kill "$monitor_pid" 2>/dev/null || true
    rm -r "$capture_dir"
  }
  trap cleanup_attachment RETURN

  stdbuf -oL busctl --user --json=short monitor org.kde.kdeconnect >"$capture_file" &
  monitor_pid=$!
  sleep 0.1
  busctl --user call org.kde.kdeconnect "$device_path" \
    org.kde.kdeconnect.device.conversations requestAttachmentFile xs "$part_id" "$unique" >/dev/null

  path=""
  for attempt in $(seq 1 60); do
    path="$(jq -r --arg unique "$unique" '
      select(.type == "signal"
          and .interface == "org.kde.kdeconnect.device.conversations"
          and .member == "attachmentReceived")
      | select(.payload.data[1] == $unique)
      | .payload.data[0]
    ' "$capture_file" 2>/dev/null | head -n 1)"
    [[ -z $path ]] || break
    sleep 0.5
  done

  if [[ -z $path || ! -f $path ]]; then
    echo "Attachment did not arrive from the phone" >&2
    exit 1
  fi
  printf '%s\n' "$path"
}

attachment_save() {
  local source="${1:-}" downloads base name ext target n
  [[ -n $source && -f $source ]] || usage
  downloads="$(xdg-user-dir DOWNLOAD 2>/dev/null || true)"
  [[ -n $downloads && $downloads != "$HOME" ]] || downloads="$HOME/Downloads"
  mkdir -p "$downloads"
  base="$(basename "$source")"
  target="$downloads/$base"
  n=1
  while [[ -e $target ]]; do
    name="${base%.*}"
    ext="${base##*.}"
    if [[ -z $name || $name == "$base" ]]; then
      target="$downloads/$base-$n"
    else
      target="$downloads/$name-$n.$ext"
    fi
    n=$((n + 1))
  done
  cp "$source" "$target"
  printf '%s\n' "$target"
}

reply() {
  local device_id="${1:-}" thread_id="${2:-}" message="${3:-}"
  [[ $device_id =~ ^[A-Za-z0-9]+$ && $thread_id =~ ^[0-9]+$ && -n $message ]] || usage
  busctl --user call org.kde.kdeconnect \
    "/modules/kdeconnect/devices/$device_id" \
    org.kde.kdeconnect.device.conversations replyToConversation \
    xsav "$thread_id" "$message" 0 >/dev/null
}

send_sms() {
  local device_id="${1:-}" destination="${2:-}" message="${3:-}" digits
  digits="${destination//[^0-9]/}"
  [[ $device_id =~ ^[A-Za-z0-9]+$ && $destination =~ ^[+0-9().[:space:]-]+$ && ${#digits} -ge 3 && -n $message ]] || usage
  kdeconnect-cli --device "$device_id" --send-sms "$message" --destination "$destination"
}

case "${1:-}" in
  status) status ;;
  watch) watch ;;
  ring) shift; ring "${1:-}" ;;
  clipboard) shift; send_clipboard "${1:-}" ;;
  share) shift; share_text "${1:-}" "${2:-}" ;;
  dismiss) shift; dismiss_notification "${1:-}" "${2:-}" ;;
  dismiss-all) shift; dismiss_all_notifications "${1:-}" ;;
  notify-reply) shift; notify_reply "${1:-}" "${2:-}" "${3:-}" ;;
  contacts) shift; contacts "${1:-}" ;;
  conversations) shift; conversations "${1:-}" ;;
  messages) shift; messages "${1:-}" "${2:-}" ;;
  attachment) shift; attachment "${1:-}" "${2:-}" "${3:-}" ;;
  attachment-save) shift; attachment_save "${1:-}" ;;
  reply) shift; reply "${1:-}" "${2:-}" "${3:-}" ;;
  sms) shift; send_sms "${1:-}" "${2:-}" "${3:-}" ;;
  *) usage ;;
esac
